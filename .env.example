# Server
PORT=3000
NODE_ENV=development

# Database (SQLite). In Docker, use file:/app/data/sqlite.db
DATABASE_URL="file:./data/sqlite.db"

# Jira Cloud
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token

# Optional: Jira custom field id for "time exported[dropdown]" (used when marking issue as exported after invoice).
# Find it in Jira: issue → Configure → Fields → time exported → id (e.g. customfield_10001).
# If not set, invoice generation still works but Jira issues will not be marked as exported.
# JIRA_DOWNTIME_EXPORTED_FIELD_ID=customfield_10001

# Optional: Jira custom field id for "Epic Link" (used to show epic title on invoice lines).
# If set, issues with this field will show the linked epic's summary in the Epic column.
# Otherwise, epic title is taken from the issue's parent (e.g. subtask parent).
# JIRA_EPIC_LINK_FIELD_ID=customfield_10014

# Email (for "Email invoice" – sends PDF from your address to client billing emails)
INVOICE_FROM_EMAIL=Wayne.bohannon@bohannonindustries.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Optional: set to 0 to disable serving the React frontend (e.g. when using separate frontend dev server)
# SERVE_FRONTEND=1
